// KAYAN ERP — database schema
//
// ⚠ DEVIATION FROM ADR-002. The approved architecture is PostgreSQL with
// Row-Level Security. Neither PostgreSQL nor Docker is available on this
// machine, so development runs on SQLite.
//
//   - RLS does not exist. Tenant isolation is enforced in the repository
//     layer only, which ADR-002 called insufficient for production.
//   - Enums are modelled as String with the allowed values documented and
//     enforced by Zod at the application boundary. Promoting them to native
//     Postgres enums is a migration, not a redesign.
//   - Money is Float here because SQLite has no DECIMAL. On Postgres these
//     become NUMERIC(19,4) / NUMERIC(19,8). DI-3 prohibits floats in
//     financial paths, so no money arithmetic happens in this phase —
//     these columns are storage only until the Cost Engine is built.
//
// Conventions
//   - Master data soft-deletes (isDeleted + deletedAt); transactional data
//     never deletes.
//   - Every tenant-scoped table carries tenantId and indexes it first.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// Platform
// ═══════════════════════════════════════════════════════════

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  companies         Company[]
  users             User[]
  products          Product[]
  categories        Category[]
  colors            Color[]
  sizes             Size[]
  materials         Material[]
  printingOptions   PrintingOption[]
  embroideryOptions EmbroideryOption[]
  warehouses        Warehouse[]
  customers         Customer[]
  suppliers         Supplier[]
  stockMovements    StockMovement[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
}

model Company {
  id       String @id @default(cuid())
  tenantId String
  name     String
  nameAr   String
  currency String @default("EGP")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════
// Identity & Access — FROZEN (Phase 2). Do not modify.
// ═══════════════════════════════════════════════════════════

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String    @unique
  passwordHash String
  name         String
  nameAr       String?
  roleId       String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role           Role               @relation(fields: [roleId], references: [id])
  sessions       Session[]
  audits         AuditLog[]
  stockMovements StockMovement[]
  activities     CustomerActivity[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]

  @@index([tenantId])
  @@index([roleId])
}

model Role {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  nameAr      String
  landingPath String

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id     String @id @default(cuid())
  key    String @unique
  nameAr String
  group  String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only. Never updated, never deleted (DI-1).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

// ═══════════════════════════════════════════════════════════
// Lookups — colours, sizes, materials, decoration options
// ═══════════════════════════════════════════════════════════

model Color {
  id        String    @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String?
  /// #RRGGBB — used for the swatch in the UI.
  hex       String?
  sortOrder Int       @default(0)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([tenantId, nameAr])
  @@index([tenantId, isDeleted])
}

model Size {
  id        String    @id @default(cuid())
  tenantId  String
  /// S, M, L, XL, 2XL … or a numeric size.
  code      String
  nameAr    String
  /// Orders sizes correctly; alphabetical sorting puts XL before XS.
  sortOrder Int       @default(0)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
}

model Material {
  id        String    @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String?
  /// Free text for now — cotton 180gsm, polyester, etc.
  spec      String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductMaterial[]

  @@unique([tenantId, nameAr])
  @@index([tenantId, isDeleted])
}

/// طرق الطباعة — screen, DTF, sublimation, heat transfer…
model PrintingOption {
  id        String    @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String?
  notes     String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductPrintingOption[]

  @@unique([tenantId, nameAr])
  @@index([tenantId, isDeleted])
}

/// أنواع التطريز — flat, 3D puff, chenille…
model EmbroideryOption {
  id        String    @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String?
  notes     String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductEmbroideryOption[]

  @@unique([tenantId, nameAr])
  @@index([tenantId, isDeleted])
}

// ═══════════════════════════════════════════════════════════
// Catalogue
// ═══════════════════════════════════════════════════════════

model Category {
  id            String    @id @default(cuid())
  tenantId      String
  /// Self-reference gives subcategories without a second model.
  parentId      String?
  slug          String
  nameAr        String
  nameEn        String
  driveFolderId String?
  sortOrder     Int       @default(0)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  /// @default is required as well as @updatedAt: the column is being added
  /// to a table that already holds rows, and those rows need a value.
  updatedAt     DateTime  @default(now()) @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, isDeleted])
  @@index([parentId])
}

model Product {
  id            String    @id @default(cuid())
  tenantId      String
  categoryId    String
  sku           String
  barcode       String?
  /// Payload encoded into the printed QR label.
  qrPayload     String?
  nameAr        String
  nameEn        String?
  descriptionAr String?
  driveFolderId String?
  /// Storage only until the Cost Engine exists — see header note on money.
  cost          Float?
  sellingPrice  Float?
  /// ACTIVE | DRAFT | DISCONTINUED
  status        String    @default("ACTIVE")
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          Category                  @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  images            ProductImage[]
  materials         ProductMaterial[]
  printingOptions   ProductPrintingOption[]
  embroideryOptions ProductEmbroideryOption[]
  suppliers         SupplierProduct[]
  stockMovements    StockMovement[]
  quotationLines    QuotationLine[]
  salesOrderLines   SalesOrderLine[]

  @@unique([tenantId, sku])
  @@index([tenantId, isDeleted])
  @@index([tenantId, categoryId])
  @@index([barcode])
}

/// المتغيّر — منتج + لون + مقاس. وحدة تتبّع المخزون.
///
/// Stock lives here, never on Product. A product with three colours in five
/// sizes is fifteen independently stocked things, and treating it as one
/// makes every stock figure meaningless.
model ProductVariant {
  id           String    @id @default(cuid())
  productId    String
  colorId      String?
  sizeId       String?
  sku          String
  barcode      String?
  cost         Float?
  sellingPrice Float?
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product         Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  color           Color?           @relation(fields: [colorId], references: [id])
  size            Size?            @relation(fields: [sizeId], references: [id])
  images          ProductImage[]
  stock           Stock[]
  stockMovements  StockMovement[]
  quotationLines  QuotationLine[]
  salesOrderLines SalesOrderLine[]

  @@unique([sku])
  @@unique([productId, colorId, sizeId])
  @@index([productId])
  @@index([barcode])
}

/// Images attach to a product, and optionally to one of its variants.
/// variantId null = a general product image.
model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  variantId   String?
  path        String
  width       Int
  height      Int
  bytes       Int
  isPrimary   Boolean @default(false)
  sortOrder   Int     @default(0)
  /// Source Drive file id — the duplicate-detection key on re-import.
  driveFileId String? @unique

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
}

model ProductMaterial {
  productId  String
  materialId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([productId, materialId])
}

model ProductPrintingOption {
  productId String
  optionId  String

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  PrintingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
}

model ProductEmbroideryOption {
  productId String
  optionId  String

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  EmbroideryOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
}

// ═══════════════════════════════════════════════════════════
// Inventory
// ═══════════════════════════════════════════════════════════

model Warehouse {
  id        String    @id @default(cuid())
  tenantId  String
  code      String
  nameAr    String
  address   String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations      WarehouseLocation[]
  stock          Stock[]
  stockMovements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
}

/// الرفوف والمواقع داخل المخزن.
model WarehouseLocation {
  id          String    @id @default(cuid())
  warehouseId String
  code        String
  nameAr      String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stock          Stock[]
  stockMovements StockMovement[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

/// الرصيد الحالي — projection derived from StockMovement.
///
/// DI-2 makes movements the record of truth; this table exists so a stock
/// list does not have to sum the whole movement history on every page load.
/// It is rebuildable from StockMovement at any time.
model Stock {
  id          String  @id @default(cuid())
  variantId   String
  warehouseId String
  locationId  String?
  onHand      Float   @default(0)
  reserved    Float   @default(0)
  damaged     Float   @default(0)
  minStock    Float   @default(0)
  maxStock    Float?

  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([variantId, warehouseId, locationId])
  @@index([variantId])
  @@index([warehouseId])
}

/// حركة المخزون — append-only.
///
/// Never updated, never deleted. A mistake is corrected by posting a
/// reversing movement that references the original, so the history remains
/// a complete and auditable record of what was believed and when.
model StockMovement {
  id          String  @id @default(cuid())
  tenantId    String
  productId   String
  variantId   String
  warehouseId String
  locationId  String?

  /// RECEIPT | ISSUE | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT |
  /// RESERVE | UNRESERVE | DAMAGE | SCRAP | RETURN | REVERSAL
  type      String
  /// Signed: positive increases stock, negative decreases it.
  quantity  Float
  /// Free-text pointer to the source document until Purchasing exists.
  reference String?
  reason    String?
  userId    String?

  /// Sales linkage. Present on reservation and un-reservation movements so
  /// every one can be traced back to the order and the exact line.
  salesOrderId     String?
  salesOrderLineId String?

  /// Set when this movement reverses another. The original is never touched.
  reversesId String?        @unique
  reverses   StockMovement? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy StockMovement? @relation("Reversal")

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product        Product            @relation(fields: [productId], references: [id])
  variant        ProductVariant     @relation(fields: [variantId], references: [id])
  warehouse      Warehouse          @relation(fields: [warehouseId], references: [id])
  location       WarehouseLocation? @relation(fields: [locationId], references: [id])
  user           User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  salesOrder     SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  salesOrderLine SalesOrderLine?    @relation(fields: [salesOrderLineId], references: [id])

  /// IDEMPOTENCY GUARD.
  ///
  /// One movement of a given type per order line, enforced by the database.
  /// Confirming the same order twice cannot create a second RESERVE, and
  /// cancelling twice cannot create a second UNRESERVE — the second attempt
  /// violates this constraint rather than relying on application checks.
  @@unique([salesOrderLineId, type])
  @@index([tenantId, occurredAt])
  @@index([variantId, occurredAt])
  @@index([warehouseId])
  @@index([type])
  @@index([salesOrderId])
}

// ═══════════════════════════════════════════════════════════
// Partners — customers and suppliers
// ═══════════════════════════════════════════════════════════

model Customer {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  companyName String?
  /// Required — an order needs a human to call.
  contactName String
  phone       String
  whatsapp    String?
  email       String?
  address     String?
  taxNumber   String?
  notes       String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachments Attachment[]
  activities  CustomerActivity[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
  @@index([phone])
}

/// الجدول الزمني للعميل — calls, visits, notes.
/// Future quotations, orders and invoices post here too.
model CustomerActivity {
  id         String   @id @default(cuid())
  customerId String
  /// NOTE | CALL | VISIT | MEETING | WHATSAPP | EMAIL | SYSTEM
  type       String
  title      String
  body       String?
  userId     String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
}

model Supplier {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  name        String
  contactName String?
  phone       String
  whatsapp    String?
  email       String?
  address     String?
  taxNumber   String?
  notes       String?
  /// 1–5, set by purchasing. Null until rated.
  rating      Int?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products    SupplierProduct[]
  attachments Attachment[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
}

/// ما يورّده كل مورّد. Purchase history attaches here when Purchasing exists.
model SupplierProduct {
  supplierId   String
  productId    String
  supplierSku  String?
  lastPrice    Float?
  leadTimeDays Int?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([supplierId, productId])
}

// ═══════════════════════════════════════════════════════════
// Sales — Phase 4
// ═══════════════════════════════════════════════════════════

/// عرض السعر.
///
/// Totals are stored, not derived on read. A quotation is a statement made
/// on a date; recomputing it later from current prices would silently
/// rewrite history.
model Quotation {
  id         String  @id @default(cuid())
  tenantId   String
  number     String
  customerId String
  /// The representative who owns this quotation.
  salesRepId String?

  /// DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  status     String    @default("DRAFT")
  issueDate  DateTime  @default(now())
  expiryDate DateTime?
  notes      String?

  /// Snapshot totals — see the money note in the schema header.
  subtotal        Float @default(0)
  discountAmount  Float @default(0)
  discountPercent Float @default(0)
  taxAmount       Float @default(0)
  total           Float @default(0)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer        @relation(fields: [customerId], references: [id])
  salesRep    User?           @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  lines       QuotationLine[]
  salesOrders SalesOrder[]
  attachments Attachment[]

  @@unique([tenantId, number])
  @@index([tenantId, isDeleted])
  @@index([tenantId, status])
  @@index([customerId])
}

/// بند عرض السعر.
///
/// PRICING SNAPSHOT. unitPrice, discount and tax are copied from the product
/// at the moment the line is written and are never recalculated. If the
/// product price changes tomorrow, this line still says what was quoted.
model QuotationLine {
  id          String @id @default(cuid())
  quotationId String
  productId   String
  variantId   String
  lineNo      Int    @default(1)

  quantity        Float
  unitPrice       Float
  discountAmount  Float   @default(0)
  discountPercent Float   @default(0)
  taxRate         Float   @default(0)
  taxAmount       Float   @default(0)
  lineTotal       Float
  notes           String?

  /// Reserved for the Cost Engine (Phase 6+). Null until it exists — a
  /// column that is present but honestly empty beats retrofitting the table
  /// once historical documents already depend on its shape.
  costSnapshot   Float?
  costSource     String?
  formulaVersion String?
  grossProfit    Float?
  marginPercent  Float?

  quotation Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([quotationId])
  @@index([variantId])
}

/// أمر البيع.
model SalesOrder {
  id          String  @id @default(cuid())
  tenantId    String
  number      String
  customerId  String
  quotationId String?
  salesRepId  String?

  /// DRAFT | CONFIRMED | IN_PRODUCTION | READY | DELIVERED | CANCELLED | COMPLETED
  status               String    @default("DRAFT")
  orderDate            DateTime  @default(now())
  requiredDeliveryDate DateTime?
  notes                String?

  subtotal        Float @default(0)
  discountAmount  Float @default(0)
  discountPercent Float @default(0)
  taxAmount       Float @default(0)
  total           Float @default(0)

  /// Set the first time the order is confirmed and reservations are posted.
  /// Read as "reservations exist for this order".
  confirmedAt DateTime?
  cancelledAt DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer         @relation(fields: [customerId], references: [id])
  quotation   Quotation?       @relation(fields: [quotationId], references: [id])
  salesRep    User?            @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  lines       SalesOrderLine[]
  movements   StockMovement[]
  attachments Attachment[]

  @@unique([tenantId, number])
  @@index([tenantId, isDeleted])
  @@index([tenantId, status])
  @@index([customerId])
}

model SalesOrderLine {
  id           String @id @default(cuid())
  salesOrderId String
  productId    String
  variantId    String
  lineNo       Int    @default(1)

  quantity        Float
  unitPrice       Float
  discountAmount  Float   @default(0)
  discountPercent Float   @default(0)
  taxRate         Float   @default(0)
  taxAmount       Float   @default(0)
  lineTotal       Float
  notes           String?

  costSnapshot   Float?
  costSource     String?
  formulaVersion String?
  grossProfit    Float?
  marginPercent  Float?

  salesOrder SalesOrder      @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id])
  variant    ProductVariant  @relation(fields: [variantId], references: [id])
  movements  StockMovement[]

  @@index([salesOrderId])
  @@index([variantId])
}

/// المرفقات.
///
/// Nullable foreign keys rather than an entityType/entityId pair, so the
/// database still enforces referential integrity. Exactly one owner is set.
model Attachment {
  id           String   @id @default(cuid())
  customerId   String?
  supplierId   String?
  quotationId  String?
  salesOrderId String?
  filename     String
  path         String
  mimeType     String
  bytes        Int
  uploadedBy   String?
  createdAt    DateTime @default(now())

  customer   Customer?   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier   Supplier?   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  quotation  Quotation?  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([supplierId])
  @@index([quotationId])
  @@index([salesOrderId])
}
