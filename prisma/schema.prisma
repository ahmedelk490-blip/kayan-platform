// KAYAN ERP — database schema
//
// MySQL. See the datasource block below for what moved and what it cost.
// was always PostgreSQL with Row-Level Security, and development ran on
// SQLite only because neither PostgreSQL nor Docker was installable here.
// Both deviations recorded in earlier phases are closed:
//
//   - RLS EXISTS. Every tenant-owned table has RLS enabled and FORCED, with
//     policies keyed on the app.tenant_id session setting. Forcing matters:
//     without it the table owner would silently bypass its own policies.
//     Tenant isolation is no longer repository-layer-only.
//
//   - MONEY AND QUANTITY ARE GENUINELY EXACT. Columns are NUMERIC(19,4).
//     On SQLite the DECIMAL column was float-backed and exact only below
//     ~15 significant digits; that ceiling is gone. Prisma still returns
//     Prisma.Decimal, so no application arithmetic changed.
//
//     Quantities are Decimal too, deliberately: quantity × unitPrice would
//     inherit float error from the quantity even if the price were exact.
//
// Conventions
//   - Master data soft-deletes (isDeleted + deletedAt); transactional data
//     never deletes.
//   - Every tenant-scoped table carries tenantId and indexes it first.
//   - Enums remain String with allowed values documented and enforced by Zod
//     at the application boundary. Promoting them to native Postgres enums is
//     a migration, not a redesign, and is deliberately not bundled with this
//     one — a data move and a type change should not fail together.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
// Why MySQL, and what moved with it
// ═══════════════════════════════════════════════════════════
//
// The hosting this runs on offers MySQL and nothing else. PostgreSQL would
// need a second service or a VPS, and the decision was to stay on one bill.
//
// What that costs, stated plainly:
//
//   - ROW-LEVEL SECURITY IS GONE. MySQL has no equivalent. Tenant isolation
//     now rests entirely on every query carrying its tenant — which
//     scripts/verify-tenant-scoping.mjs measures across all 240 call sites,
//     reads and writes. Moving found three deletes that took an id from the
//     browser and never checked ownership; the database had been refusing
//     them from underneath. One tenant exists, so nothing was exploitable.
//
//   - NULLS NOT DISTINCT IS GONE. PriceTier leaned on it: a price for a
//     whole product leaves variantId null, and both engines treat null as
//     distinct from null, so two tiers for the same quantity would both be
//     accepted and the price would depend on row order. A generated column
//     folds null to a sentinel so the unique index bites. This is the one
//     constraint in the schema that needed it — scripts/audit-null-uniques.mjs
//     checked the other forty.
//
// What did not change:
//
//   - MONEY AND QUANTITY ARE STILL EXACT. NUMERIC(19,4) and DECIMAL(19,4)
//     are the same fixed-point type; Prisma still returns Prisma.Decimal and
//     no arithmetic moved.
//
//   - No arrays, no JSON columns, no engine-specific types anywhere in the
//     sixty models, which is why the schema itself crosses unchanged.
//
// Charset must be utf8mb4. MySQL's "utf8" is three bytes and silently
// truncates anything above the BMP; the whole product catalogue is Arabic.

// ═══════════════════════════════════════════════════════════
// Platform
// ═══════════════════════════════════════════════════════════

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  companies         Company[]
  users             User[]
  products          Product[]
  categories        Category[]
  colors            Color[]
  sizes             Size[]
  materials         Material[]
  printingOptions   PrintingOption[]
  embroideryOptions EmbroideryOption[]
  warehouses        Warehouse[]
  customers         Customer[]
  suppliers         Supplier[]
  stockMovements    StockMovement[]
  quotations        Quotation[]
  salesOrders       SalesOrder[]
  productionOrders  ProductionOrder[]
  formulas          Formula[]
  costCalculations  CostCalculation[]

  secondaryExpenses  SecondaryExpense[]
  damageRecords      DamageRecord[]
  penalties          Penalty[]
  supplies           Supply[]
  supplyTransactions SupplyTransaction[]
  purchaseOrders     PurchaseOrder[]
  goodsReceipts      GoodsReceipt[]
  invoices           Invoice[]
  payments           Payment[]
  documentSequences  DocumentSequence[]
  priceTiers PriceTier[]
  siteContent SiteContent[]
  heroSlides HeroSlide[]
  employeePayments EmployeePayment[]
  productBundles ProductBundle[]
  webOrders WebOrder[]
}

model Company {
  id       String @id @default(cuid())
  tenantId String
  name     String
  nameAr   String
  currency String @default("EGP")

  /// ── Invoicing settings (Phase 10) ──────────────────────
  ///
  /// Three business facts nobody has supplied yet. They are settings rather
  /// than constants so the module works today and the manager sets the truth
  /// when they know it.

  /// Default VAT percentage applied to new invoice lines.
  ///
  /// Zero, deliberately. A hardcoded 14 would produce invoices with a number
  /// that looks right and might not be — visibly wrong beats plausibly wrong.
  defaultTaxRate Decimal @default(0) @db.Decimal(19, 4)

  /// Days between issue and due. Zero means due on issue, the most
  /// conservative reading of "we have not agreed terms" — assuming a month of
  /// free credit on the customer's behalf is a decision nobody made.
  paymentTermDays Int @default(0)

  /// The terms sentence printed on the document, in the words the business
  /// uses with its own customers. Null means nothing is printed — a generic
  /// "الدفع خلال 30 يوماً" would be a term nobody agreed to.
  paymentTerms String?

  /// Prefix for the gapless invoice sequence.
  invoicePrefix String @default("INV")

  /// Printed on the invoice when set. Not invented.
  taxNumber          String?
  commercialRegister String?

  /// رقم واتساب الموقع العام — بصيغة دولية بلا رموز: 9647XXXXXXXXX
  ///
  /// كان متغيّر بيئة، فتغييره كان يستلزم نشراً. صار هنا ليعدّله المدير من
  /// الشاشة ويظهر فوراً — رقم التواصل بيان عمل لا إعداد بنية تحتية.
  ///
  /// فارغ يعني لا زر إطلاقاً. رقم مخترع أسوأ من غيابه.
  whatsapp   String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// ═══════════════════════════════════════════════════════════
// Identity & Access — FROZEN (Phase 2). Do not modify.
// ═══════════════════════════════════════════════════════════

model User {
  id           String    @id @default(cuid())
  tenantId     String
  email        String    @unique
  passwordHash String
  name         String
  nameAr       String?
  roleId       String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  /// راتب شهري ثابت للموظف (اختياري) ونسبة عمولته من أرباح فواتيره.
  monthlySalary     Decimal? @db.Decimal(19, 4)
  commissionPercent Decimal? @db.Decimal(19, 4)

  /// تحكّم صلاحيات لكل موظف فوق دوره: JSON بمصفوفتَي مفاتيح — ما يُمنح زيادةً
  /// على الدور، وما يُسحب منه. الصافي = (صلاحيات الدور ∪ الممنوح) − المسحوب.
  grantedPermissions String? @db.Text
  deniedPermissions  String? @db.Text

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                     Role                      @relation(fields: [roleId], references: [id])
  sessions                 Session[]
  audits                   AuditLog[]
  stockMovements           StockMovement[]
  activities               CustomerActivity[]
  quotations               Quotation[]
  salesOrders              SalesOrder[]
  productionOrderAssignees ProductionOrderAssignee[]
  formulaVersions          FormulaVersion[]
  costCalculations         CostCalculation[]

  // Phase 6.5. Three roles per record — the person it concerns, the person
  // who filed it, the person who approved it — so each needs its own named
  // relation rather than one ambiguous link.
  expensesAsEmployee    SecondaryExpense[]  @relation("ExpenseEmployee")
  expensesApproved      SecondaryExpense[]  @relation("ExpenseApprover")
  expensesCreated       SecondaryExpense[]  @relation("ExpenseCreator")
  damagesAsEmployee     DamageRecord[]      @relation("DamageEmployee")
  damagesApproved       DamageRecord[]      @relation("DamageApprover")
  damagesCreated        DamageRecord[]      @relation("DamageCreator")
  penaltiesAsEmployee   Penalty[]           @relation("PenaltyEmployee")
  penaltiesApproved     Penalty[]           @relation("PenaltyApprover")
  penaltiesCreated      Penalty[]           @relation("PenaltyCreator")
  penaltyEvents         PenaltyEvent[]
  supplyTransactions    SupplyTransaction[]
  purchaseOrdersCreated PurchaseOrder[]     @relation("PurchaseCreator")
  goodsReceipts         GoodsReceipt[]
  invoicesIssued        Invoice[]           @relation("InvoiceIssuer")
  invoicesCreated       Invoice[]           @relation("InvoiceCreator")
  paymentsRecorded      Payment[]
  employeePayments      EmployeePayment[]   @relation("EmployeePaymentEmployee")
  employeePaymentsMade  EmployeePayment[]   @relation("EmployeePaymentCreator")

  @@index([tenantId])
  @@index([roleId])
}

/// دفعة/خصم للموظف: راتب، عمولة، مقابل خدمة، مكافأة، خصم، سلفة.
///
/// سجلّ واحد لكل حركة مالية مع الموظف، لتُجمَّع في كشف مستحقاته: الموجب
/// يُدفع له (SALARY/COMMISSION/SERVICE/BONUS) والسالب يُخصم (DEDUCTION/ADVANCE).
model EmployeePayment {
  id         String   @id @default(cuid())
  tenantId   String
  number     String
  employeeId String

  /// SALARY | COMMISSION | SERVICE | BONUS | DEDUCTION | ADVANCE
  kind   String
  amount Decimal @db.Decimal(19, 4)
  paidAt DateTime @default(now())

  /// للراتب: الشهر والسنة اللذان يخصّهما، لتفادي ازدواج صرف الشهر.
  periodMonth Int?
  periodYear  Int?

  note        String?
  createdById String?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  User   @relation("EmployeePaymentEmployee", fields: [employeeId], references: [id])
  createdBy User?  @relation("EmployeePaymentCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tenantId, employeeId])
  @@index([tenantId, paidAt])
}

model Role {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  nameAr      String
  landingPath String

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id     String @id @default(cuid())
  key    String @unique
  nameAr String
  group  String

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  ip        String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Append-only. Never updated, never deleted (DI-1).
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  detail     String?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
}

// ═══════════════════════════════════════════════════════════
// Lookups — colours, sizes, materials, decoration options
// ═══════════════════════════════════════════════════════════

model Color {
  id        String    @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String?
  /// #RRGGBB — used for the swatch in the UI.
  hex       String?
  sortOrder Int       @default(0)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant   Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants ProductVariant[]

  @@unique([tenantId, nameAr])
  @@index([tenantId, isDeleted])
}

model Size {
  id        String    @id @default(cuid())
  tenantId  String
  /// S, M, L, XL, 2XL … or a numeric size.
  code      String
  nameAr    String
  /// Orders sizes correctly; alphabetical sorting puts XL before XS.
  sortOrder Int       @default(0)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant      Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  variants    ProductVariant[]
  bundleLines ProductBundleLine[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
}

/// طقم/سيريه/درزن — توزيع مقاسات جاهز للمنتج. بدل إدخال كل مقاس بكميته
/// يدوياً، يعرّف المدير السيريه مرة (مثلاً: قطعتان L، ٣ XL…) فتتوسّع في
/// الفاتورة بضغطة. اللون يُختار وقت البيع؛ السيريه توزيع مقاسات لا لون.
model ProductBundle {
  id        String  @id @default(cuid())
  tenantId  String
  productId String
  /// اسم السيريه كما يراه المستخدم: «سيريه»، «درزن»…
  nameAr    String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  lines   ProductBundleLine[]

  @@index([tenantId, productId])
}

/// طلب وارد من الموقع العام — العميل اختار منتجاً بمقاسه ولونه وكميته.
///
/// مسار كتابة عامّ مقيّد (كالـleads): يُنشئ طلباً معلّقاً فقط، لا فاتورة ولا
/// وصولاً لأي كيان آخر. المندوب يراجعه في الـERP ويحوّله لفاتورة بضغطة —
/// عندها تُنسخ الأسعار وتُخصَّص أرقامها. المنتج/المتغيّر تُخزَّن كمعرّفات
/// وكنصوص وصفية معاً، فالطلب يبقى مقروءاً ولو حُذف المنتج لاحقاً.
model WebOrder {
  id           String  @id @default(cuid())
  tenantId     String
  number       String
  customerName String
  phone        String
  company      String?
  note         String?
  /// PENDING | CONVERTED | REJECTED
  status       String  @default("PENDING")
  /// الفاتورة الناتجة بعد التحويل (بلا علاقة صريحة — مجرّد ربط).
  invoiceId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lines  WebOrderLine[]

  @@index([tenantId, status])
}

/// سطر في طلب الموقع: منتج/متغيّر وكميته، مع نصوص وصفية محفوظة.
model WebOrderLine {
  id           String  @id @default(cuid())
  webOrderId   String
  productId    String
  variantId    String?
  productLabel String
  colorLabel   String?
  sizeLabel    String?
  quantity     Int     @default(1)

  webOrder WebOrder @relation(fields: [webOrderId], references: [id], onDelete: Cascade)
}

/// سطر في السيريه: مقاس وكميته داخل الطقم الواحد.
model ProductBundleLine {
  id       String @id @default(cuid())
  bundleId String
  sizeId   String
  quantity Int    @default(1)

  bundle ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  size   Size          @relation(fields: [sizeId], references: [id])

  @@unique([bundleId, sizeId])
}

model Material {
  id        String    @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String?
  /// Free text for now — cotton 180gsm, polyester, etc.
  spec      String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products     ProductMaterial[]
  formulaLines FormulaLine[]

  @@unique([tenantId, nameAr])
  @@index([tenantId, isDeleted])
}

/// طرق الطباعة — screen, DTF, sublimation, heat transfer…
model PrintingOption {
  id        String    @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String?
  notes     String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant   Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductPrintingOption[]

  @@unique([tenantId, nameAr])
  @@index([tenantId, isDeleted])
}

/// أنواع التطريز — flat, 3D puff, chenille…
model EmbroideryOption {
  id        String    @id @default(cuid())
  tenantId  String
  nameAr    String
  nameEn    String?
  notes     String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  tenant   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products ProductEmbroideryOption[]

  @@unique([tenantId, nameAr])
  @@index([tenantId, isDeleted])
}

// ═══════════════════════════════════════════════════════════
// Catalogue
// ═══════════════════════════════════════════════════════════

model Category {
  id            String    @id @default(cuid())
  tenantId      String
  /// Self-reference gives subcategories without a second model.
  parentId      String?
  slug          String
  nameAr        String
  nameEn        String
  driveFolderId String?
  sortOrder     Int       @default(0)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  /// @default is required as well as @updatedAt: the column is being added
  /// to a table that already holds rows, and those rows need a value.
  updatedAt     DateTime  @default(now()) @updatedAt

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([tenantId, slug])
  @@index([tenantId, isDeleted])
  @@index([parentId])
}

model Product {
  id            String    @id @default(cuid())
  tenantId      String
  categoryId    String
  sku           String
  barcode       String?
  /// Payload encoded into the printed QR label.
  qrPayload     String?
  nameAr        String
  nameEn        String?
  descriptionAr String?
  driveFolderId String?
  /// Storage only until the Cost Engine exists — see header note on money.
  cost          Decimal?  @db.Decimal(19, 4)
  sellingPrice  Decimal?  @db.Decimal(19, 4)
  /// ACTIVE | DRAFT | DISCONTINUED
  status        String    @default("ACTIVE")
  /// معروض على الموقع العام؟ محور مستقل عن status: منتج قد يكون ACTIVE
  /// للاستخدام الداخلي لكن يُخفى عن الموقع. الموقع يعرض ACTIVE + showOnSite فقط.
  showOnSite    Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant            Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category          Category                  @relation(fields: [categoryId], references: [id])
  variants          ProductVariant[]
  images            ProductImage[]
  materials         ProductMaterial[]
  priceTiers        PriceTier[]
  printingOptions   ProductPrintingOption[]
  embroideryOptions ProductEmbroideryOption[]
  suppliers         SupplierProduct[]
  stockMovements    StockMovement[]
  quotationLines    QuotationLine[]
  salesOrderLines   SalesOrderLine[]
  productionOrders  ProductionOrder[]
  productFormulas   ProductFormula[]
  costCalculations  CostCalculation[]
  damageRecords     DamageRecord[]
  invoiceLines      InvoiceLine[]
  bundles           ProductBundle[]

  @@unique([tenantId, sku])
  @@index([tenantId, isDeleted])
  @@index([tenantId, categoryId])
  @@index([barcode])
}

/// المتغيّر — منتج + لون + مقاس. وحدة تتبّع المخزون.
///
/// Stock lives here, never on Product. A product with three colours in five
/// sizes is fifteen independently stocked things, and treating it as one
/// makes every stock figure meaningless.
model ProductVariant {
  id           String    @id @default(cuid())
  productId    String
  colorId      String?
  sizeId       String?
  sku          String
  barcode      String?
  cost         Decimal?  @db.Decimal(19, 4)
  sellingPrice Decimal?  @db.Decimal(19, 4)
  isActive     Boolean   @default(true)
  isDeleted    Boolean   @default(false)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  color              Color?              @relation(fields: [colorId], references: [id])
  size               Size?               @relation(fields: [sizeId], references: [id])
  images             ProductImage[]
  priceTiers         PriceTier[]
  stock              Stock[]
  stockMovements     StockMovement[]
  quotationLines     QuotationLine[]
  salesOrderLines    SalesOrderLine[]
  productionOrders   ProductionOrder[]
  productFormulas    ProductFormula[]
  costCalculations   CostCalculation[]
  damageRecords      DamageRecord[]
  purchaseOrderLines PurchaseOrderLine[]
  invoiceLines       InvoiceLine[]

  @@unique([sku])
  @@unique([productId, colorId, sizeId])
  @@index([productId])
  @@index([barcode])
}

/// Images attach to a product, and optionally to one of its variants.
/// variantId null = a general product image.
model ProductImage {
  id          String  @id @default(cuid())
  productId   String
  variantId   String?
  path        String
  width       Int
  height      Int
  bytes       Int
  isPrimary   Boolean @default(false)
  sortOrder   Int     @default(0)
  /// Source Drive file id — the duplicate-detection key on re-import.
  driveFileId String? @unique

  /// بايتات صورة رُفعت من النظام. الصور القديمة ملفات على القرص (path
  /// يبدأ بـ /products)، والمرفوعة تعيش هنا وتُقدَّم من /product-img/<id> —
  /// فتنجو من النشر الذي يمسح القرص. فارغ يعني ملفاً ثابتاً.
  data     Bytes?
  mimeType String @default("image/webp")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([variantId])
}

model ProductMaterial {
  productId  String
  materialId String

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@id([productId, materialId])
}

model ProductPrintingOption {
  productId String
  optionId  String

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  PrintingOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
}

model ProductEmbroideryOption {
  productId String
  optionId  String

  product Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  option  EmbroideryOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([productId, optionId])
}

// ═══════════════════════════════════════════════════════════
// Inventory
// ═══════════════════════════════════════════════════════════

model Warehouse {
  id        String    @id @default(cuid())
  tenantId  String
  code      String
  nameAr    String
  address   String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations      WarehouseLocation[]
  stock          Stock[]
  stockMovements StockMovement[]
  goodsReceipts  GoodsReceipt[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
}

/// الرفوف والمواقع داخل المخزن.
model WarehouseLocation {
  id          String    @id @default(cuid())
  warehouseId String
  code        String
  nameAr      String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())

  warehouse      Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  stock          Stock[]
  stockMovements StockMovement[]

  @@unique([warehouseId, code])
  @@index([warehouseId])
}

/// الرصيد الحالي — projection derived from StockMovement.
///
/// DI-2 makes movements the record of truth; this table exists so a stock
/// list does not have to sum the whole movement history on every page load.
/// It is rebuildable from StockMovement at any time.
model Stock {
  id          String   @id @default(cuid())
  variantId   String
  warehouseId String
  locationId  String?
  onHand      Decimal  @default(0) @db.Decimal(19, 4)
  reserved    Decimal  @default(0) @db.Decimal(19, 4)
  damaged     Decimal  @default(0) @db.Decimal(19, 4)
  minStock    Decimal  @default(0) @db.Decimal(19, 4)
  maxStock    Decimal? @db.Decimal(19, 4)

  variant   ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  location  WarehouseLocation? @relation(fields: [locationId], references: [id])

  updatedAt DateTime @updatedAt

  @@unique([variantId, warehouseId, locationId])
  @@index([variantId])
  @@index([warehouseId])
}

/// حركة المخزون — append-only.
///
/// Never updated, never deleted. A mistake is corrected by posting a
/// reversing movement that references the original, so the history remains
/// a complete and auditable record of what was believed and when.
model StockMovement {
  id          String  @id @default(cuid())
  tenantId    String
  productId   String
  variantId   String
  warehouseId String
  locationId  String?

  /// RECEIPT | ISSUE | TRANSFER_IN | TRANSFER_OUT | ADJUSTMENT |
  /// RESERVE | UNRESERVE | DAMAGE | SCRAP | RETURN | REVERSAL
  type      String
  /// Signed: positive increases stock, negative decreases it.
  quantity  Decimal @db.Decimal(19, 4)
  /// Free-text pointer to the source document until Purchasing exists.
  reference String?
  reason    String?
  userId    String?

  /// Sales linkage. Present on reservation and un-reservation movements so
  /// every one can be traced back to the order and the exact line.
  salesOrderId     String?
  salesOrderLineId String?

  /// Manufacturing linkage — finished-goods receipts on completion.
  productionOrderId String?

  /// Purchasing linkage — goods arriving from a supplier. Unique per type
  /// below, so a receipt posted twice cannot move stock twice.
  goodsReceiptLineId String?

  /// Set when this movement reverses another. The original is never touched.
  reversesId String?        @unique
  reverses   StockMovement? @relation("Reversal", fields: [reversesId], references: [id])
  reversedBy StockMovement? @relation("Reversal")

  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product          Product            @relation(fields: [productId], references: [id])
  variant          ProductVariant     @relation(fields: [variantId], references: [id])
  warehouse        Warehouse          @relation(fields: [warehouseId], references: [id])
  location         WarehouseLocation? @relation(fields: [locationId], references: [id])
  user             User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  salesOrder       SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  salesOrderLine   SalesOrderLine?    @relation(fields: [salesOrderLineId], references: [id])
  productionOrder  ProductionOrder?   @relation(fields: [productionOrderId], references: [id])
  goodsReceiptLine GoodsReceiptLine?  @relation(fields: [goodsReceiptLineId], references: [id])

  /// IDEMPOTENCY GUARDS.
  ///
  /// One movement of a given type per order line, enforced by the database.
  /// Confirming the same order twice cannot create a second RESERVE, and
  /// cancelling twice cannot create a second UNRESERVE — the second attempt
  /// violates this constraint rather than relying on application checks.
  ///
  /// The same protection for manufacturing: completing a production order
  /// twice cannot book its output twice.
  @@unique([salesOrderLineId, type])
  @@unique([productionOrderId, type])
  @@unique([goodsReceiptLineId, type])
  @@index([tenantId, occurredAt])
  @@index([variantId, occurredAt])
  @@index([warehouseId])
  @@index([type])
  @@index([salesOrderId])
}

// ═══════════════════════════════════════════════════════════
// Partners — customers and suppliers
// ═══════════════════════════════════════════════════════════

model Customer {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  companyName String?
  /// Required — an order needs a human to call.
  contactName String
  phone       String
  whatsapp    String?
  email       String?
  address     String?
  taxNumber   String?
  notes       String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  attachments      Attachment[]
  activities       CustomerActivity[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  productionOrders ProductionOrder[]
  invoices         Invoice[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
  @@index([phone])
}

/// الجدول الزمني للعميل — calls, visits, notes.
/// Future quotations, orders and invoices post here too.
model CustomerActivity {
  id         String   @id @default(cuid())
  customerId String
  /// NOTE | CALL | VISIT | MEETING | WHATSAPP | EMAIL | SYSTEM
  type       String
  title      String
  body       String?
  userId     String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([customerId, occurredAt])
}

model Supplier {
  id          String    @id @default(cuid())
  tenantId    String
  code        String
  name        String
  contactName String?
  phone       String
  whatsapp    String?
  email       String?
  address     String?
  taxNumber   String?
  notes       String?
  /// 1–5, set by purchasing. Null until rated.
  rating      Int?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant         Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       SupplierProduct[]
  attachments    Attachment[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
}

/// ما يورّده كل مورّد. Purchase history attaches here when Purchasing exists.
model SupplierProduct {
  supplierId   String
  productId    String
  supplierSku  String?
  lastPrice    Decimal? @db.Decimal(19, 4)
  leadTimeDays Int?

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([supplierId, productId])
}

// ═══════════════════════════════════════════════════════════
// Sales — Phase 4
// ═══════════════════════════════════════════════════════════

/// عرض السعر.
///
/// Totals are stored, not derived on read. A quotation is a statement made
/// on a date; recomputing it later from current prices would silently
/// rewrite history.
model Quotation {
  id         String  @id @default(cuid())
  tenantId   String
  number     String
  customerId String
  /// The representative who owns this quotation.
  salesRepId String?

  /// DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  status     String    @default("DRAFT")
  issueDate  DateTime  @default(now())
  expiryDate DateTime?
  notes      String?

  /// Snapshot totals — see the money note in the schema header.
  subtotal        Decimal @default(0) @db.Decimal(19, 4)
  discountAmount  Decimal @default(0) @db.Decimal(19, 4)
  discountPercent Decimal @default(0) @db.Decimal(19, 4)
  taxAmount       Decimal @default(0) @db.Decimal(19, 4)
  total           Decimal @default(0) @db.Decimal(19, 4)

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer    Customer        @relation(fields: [customerId], references: [id])
  salesRep    User?           @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  lines       QuotationLine[]
  salesOrders SalesOrder[]
  attachments Attachment[]

  @@unique([tenantId, number])
  @@index([tenantId, isDeleted])
  @@index([tenantId, status])
  @@index([customerId])
}

/// بند عرض السعر.
///
/// PRICING SNAPSHOT. unitPrice, discount and tax are copied from the product
/// at the moment the line is written and are never recalculated. If the
/// product price changes tomorrow, this line still says what was quoted.
model QuotationLine {
  id          String @id @default(cuid())
  quotationId String
  productId   String
  variantId   String
  lineNo      Int    @default(1)

  quantity        Decimal @db.Decimal(19, 4)
  unitPrice       Decimal @db.Decimal(19, 4)
  discountAmount  Decimal @default(0) @db.Decimal(19, 4)
  discountPercent Decimal @default(0) @db.Decimal(19, 4)
  taxRate         Decimal @default(0) @db.Decimal(19, 4)
  taxAmount       Decimal @default(0) @db.Decimal(19, 4)
  lineTotal       Decimal @db.Decimal(19, 4)
  notes           String?

  /// Reserved for the Cost Engine (Phase 6+). Null until it exists — a
  /// column that is present but honestly empty beats retrofitting the table
  /// once historical documents already depend on its shape.
  costSnapshot   Decimal? @db.Decimal(19, 4)
  costSource     String?
  formulaVersion String?
  grossProfit    Decimal? @db.Decimal(19, 4)
  marginPercent  Decimal? @db.Decimal(19, 4)

  quotation Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([quotationId])
  @@index([variantId])
}

/// أمر البيع.
model SalesOrder {
  id          String  @id @default(cuid())
  tenantId    String
  number      String
  customerId  String
  quotationId String?
  salesRepId  String?

  /// DRAFT | CONFIRMED | IN_PRODUCTION | READY | DELIVERED | CANCELLED | COMPLETED
  status               String    @default("DRAFT")
  orderDate            DateTime  @default(now())
  requiredDeliveryDate DateTime?
  notes                String?

  subtotal        Decimal @default(0) @db.Decimal(19, 4)
  discountAmount  Decimal @default(0) @db.Decimal(19, 4)
  discountPercent Decimal @default(0) @db.Decimal(19, 4)
  taxAmount       Decimal @default(0) @db.Decimal(19, 4)
  total           Decimal @default(0) @db.Decimal(19, 4)

  /// Set the first time the order is confirmed and reservations are posted.
  /// Read as "reservations exist for this order".
  confirmedAt DateTime?
  cancelledAt DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer         Customer          @relation(fields: [customerId], references: [id])
  quotation        Quotation?        @relation(fields: [quotationId], references: [id])
  salesRep         User?             @relation(fields: [salesRepId], references: [id], onDelete: SetNull)
  lines            SalesOrderLine[]
  movements        StockMovement[]
  attachments      Attachment[]
  productionOrders ProductionOrder[]
  invoices         Invoice[]

  @@unique([tenantId, number])
  @@index([tenantId, isDeleted])
  @@index([tenantId, status])
  @@index([customerId])
}

model SalesOrderLine {
  id           String @id @default(cuid())
  salesOrderId String
  productId    String
  variantId    String
  lineNo       Int    @default(1)

  quantity        Decimal @db.Decimal(19, 4)
  unitPrice       Decimal @db.Decimal(19, 4)
  discountAmount  Decimal @default(0) @db.Decimal(19, 4)
  discountPercent Decimal @default(0) @db.Decimal(19, 4)
  taxRate         Decimal @default(0) @db.Decimal(19, 4)
  taxAmount       Decimal @default(0) @db.Decimal(19, 4)
  lineTotal       Decimal @db.Decimal(19, 4)
  notes           String?

  costSnapshot   Decimal? @db.Decimal(19, 4)
  costSource     String?
  formulaVersion String?
  grossProfit    Decimal? @db.Decimal(19, 4)
  marginPercent  Decimal? @db.Decimal(19, 4)

  salesOrder       SalesOrder        @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  variant          ProductVariant    @relation(fields: [variantId], references: [id])
  movements        StockMovement[]
  productionOrders ProductionOrder[]
  costCalculations CostCalculation[]

  @@index([salesOrderId])
  @@index([variantId])
}

// ═══════════════════════════════════════════════════════════
// Manufacturing — Phase 5
// ═══════════════════════════════════════════════════════════

/// أمر الإنتاج.
///
/// One production order makes one variant. A sales order with three lines
/// that all need making becomes three production orders — they are planned,
/// scheduled and completed independently, and forcing them into one record
/// makes partial completion impossible to express.
model ProductionOrder {
  id       String @id @default(cuid())
  tenantId String
  number   String

  /// Optional but preferred — production can be for stock, not just to order.
  salesOrderId     String?
  salesOrderLineId String?
  customerId       String?

  productId String
  variantId String
  quantity  Decimal @db.Decimal(19, 4)

  /// LOW | NORMAL | HIGH | URGENT
  priority String @default("NORMAL")
  /// DRAFT | CONFIRMED | IN_PROGRESS | QC | COMPLETED | CANCELLED
  status   String @default("DRAFT")

  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  notes String?

  /// Reserved for the Cost Engine (Phase 6+). Null until it exists — a
  /// column present and honestly empty beats altering the table once
  /// historical orders depend on its shape.
  estimatedCost Decimal? @db.Decimal(19, 4)
  actualCost    Decimal? @db.Decimal(19, 4)

  confirmedAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant           Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  salesOrder       SalesOrder?               @relation(fields: [salesOrderId], references: [id])
  salesOrderLine   SalesOrderLine?           @relation(fields: [salesOrderLineId], references: [id])
  customer         Customer?                 @relation(fields: [customerId], references: [id])
  product          Product                   @relation(fields: [productId], references: [id])
  variant          ProductVariant            @relation(fields: [variantId], references: [id])
  assignees        ProductionOrderAssignee[]
  workOrders       WorkOrder[]
  movements        StockMovement[]
  costCalculations CostCalculation[]

  damageRecords      DamageRecord[]
  supplyTransactions SupplyTransaction[]

  @@unique([tenantId, number])
  @@index([tenantId, isDeleted])
  @@index([tenantId, status])
  @@index([salesOrderId])
  @@index([variantId])
}

/// الموظفون المكلَّفون — relation prepared, no HR workflow yet.
model ProductionOrderAssignee {
  productionOrderId String
  userId            String
  /// Free text for now: operator, supervisor, QC…
  role              String?
  createdAt         DateTime @default(now())

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([productionOrderId, userId])
  @@index([userId])
}

/// أمر التشغيل — one step of a production order.
///
/// Deliberately minimal. Routings, work centres, machine time and stitch
/// counts belong to the Formula Engine; this is the container they will
/// attach to, so that phase does not have to reshape a table that live
/// production orders already reference.
model WorkOrder {
  id                String @id @default(cuid())
  productionOrderId String
  sequence          Int
  name              String
  /// PENDING | IN_PROGRESS | DONE | SKIPPED
  status            String @default("PENDING")

  notes            String?
  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  productionOrder ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@unique([productionOrderId, sequence])
  @@index([productionOrderId])
}

// ═══════════════════════════════════════════════════════════
// Formula Engine + Cost Engine — Phase 6
// ═══════════════════════════════════════════════════════════

/// المعادلة — a named, versioned recipe for costing.
///
/// The header carries identity only. Everything that produces a number lives
/// on a version, because a number that can change retroactively makes every
/// historical cost a guess.
model Formula {
  id       String @id @default(cuid())
  tenantId String
  code     String
  nameAr   String
  /// PRINTING | EMBROIDERY | MANUFACTURING
  kind     String

  notes String?

  /// The version used when this formula is applied. Null until one is
  /// published — an unpublished formula deliberately cannot cost anything.
  currentVersionId String? @unique

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  currentVersion FormulaVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions       FormulaVersion[] @relation("FormulaVersions")
  products       ProductFormula[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
  @@index([tenantId, kind])
}

/// إصدار المعادلة.
///
/// A PUBLISHED version is immutable. Editing a published formula creates the
/// next version instead of changing this one, so a cost calculated in March
/// still reads in December exactly as it was computed. That is the whole
/// reason versions exist.
model FormulaVersion {
  id        String @id @default(cuid())
  formulaId String
  version   Int
  /// DRAFT | PUBLISHED | ARCHIVED
  status    String @default("DRAFT")

  notes String?

  publishedAt   DateTime?
  publishedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  formula       Formula                  @relation("FormulaVersions", fields: [formulaId], references: [id], onDelete: Cascade)
  publishedBy   User?                    @relation(fields: [publishedById], references: [id], onDelete: SetNull)
  currentFor    Formula?                 @relation("CurrentVersion")
  lines         FormulaLine[]
  params        FormulaParam[]
  usedIn        CostCalculationFormula[]
  snapshotLines CostCalculationLine[]

  @@unique([formulaId, version])
  @@index([formulaId, status])
}

/// مكوّن المعادلة — one costed component.
///
/// `basis` says how `quantity` becomes a consumed quantity; the engine in
/// @erp/domain holds the arithmetic. There is no expression to evaluate here
/// — Article 5 forbids running manager-supplied code, so the flexibility is
/// in the data, not in an interpreter.
model FormulaLine {
  id               String @id @default(cuid())
  formulaVersionId String
  sequence         Int

  /// MATERIAL | INK | THREAD | LABOR | PACKAGING | MACHINE | OVERHEAD | WASTE
  category   String
  nameAr     String
  /// Optional link to the materials master. Free-text lines are allowed
  /// because ink colours and machine time are not stock materials.
  materialId String?

  /// PER_PIECE | PER_ORDER | PER_YIELD | PER_1000_STITCHES | PER_MINUTE |
  /// PERCENT_OF_DIRECT
  basis String

  /// Consumption per basis unit — or the percentage, for PERCENT_OF_DIRECT.
  quantity Decimal  @db.Decimal(19, 4)
  /// Pieces produced by one `quantity`. PER_YIELD only: a 50 m roll that
  /// yields 400 shirts is quantity=50, yieldQty=400.
  yieldQty Decimal? @db.Decimal(19, 4)
  unit     String?
  /// Cost of one unit, frozen into this version.
  unitCost Decimal  @default(0) @db.Decimal(19, 4)

  notes String?

  createdAt DateTime @default(now())

  formulaVersion FormulaVersion @relation(fields: [formulaVersionId], references: [id], onDelete: Cascade)
  material       Material?      @relation(fields: [materialId], references: [id])

  @@unique([formulaVersionId, sequence])
  @@index([formulaVersionId])
  @@index([materialId])
}

/// معامل المعادلة — a named number the engine reads.
///
/// Stitch count, machine speed, setup minutes. Kept apart from lines because
/// several lines read the same figure and duplicating it would let two rows
/// disagree about how many stitches a design has.
model FormulaParam {
  id               String  @id @default(cuid())
  formulaVersionId String
  key              String
  nameAr           String
  value            Decimal @default(0) @db.Decimal(19, 4)
  unit             String?

  formulaVersion FormulaVersion @relation(fields: [formulaVersionId], references: [id], onDelete: Cascade)

  @@unique([formulaVersionId, key])
  @@index([formulaVersionId])
}

/// ربط المعادلة بالمنتج.
///
/// variantId null = the formula applies to every variant of the product. A
/// product may carry several formulas at once — a base manufacturing recipe
/// plus a printing one plus an embroidery one — and the cost engine sums them.
model ProductFormula {
  id        String  @id @default(cuid())
  productId String
  variantId String?
  formulaId String

  createdAt DateTime @default(now())

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  formula Formula         @relation(fields: [formulaId], references: [id], onDelete: Cascade)

  @@unique([productId, variantId, formulaId])
  @@index([productId])
  @@index([formulaId])
}

/// حساب التكلفة — an immutable snapshot.
///
/// Mirrors the Phase 4 pricing snapshot, for the same reason: the document
/// stores the numbers it was computed with. Republishing a formula changes
/// nothing here, because nothing here is recomputed. Ever.
model CostCalculation {
  id       String @id @default(cuid())
  tenantId String

  /// What was costed. A calculation can be an ad-hoc estimate with neither.
  productionOrderId String?
  salesOrderLineId  String?

  productId String
  variantId String
  quantity  Decimal @db.Decimal(19, 4)

  /// ESTIMATE | ACTUAL
  kind String @default("ESTIMATE")

  /// The eight reported buckets, each summed from the snapshot lines.
  materialCost  Decimal @default(0) @db.Decimal(19, 4)
  inkCost       Decimal @default(0) @db.Decimal(19, 4)
  threadCost    Decimal @default(0) @db.Decimal(19, 4)
  laborCost     Decimal @default(0) @db.Decimal(19, 4)
  packagingCost Decimal @default(0) @db.Decimal(19, 4)
  machineCost   Decimal @default(0) @db.Decimal(19, 4)
  overheadCost  Decimal @default(0) @db.Decimal(19, 4)
  wasteCost     Decimal @default(0) @db.Decimal(19, 4)

  directCost   Decimal @default(0) @db.Decimal(19, 4)
  indirectCost Decimal @default(0) @db.Decimal(19, 4)
  totalCost    Decimal @default(0) @db.Decimal(19, 4)
  costPerPiece Decimal @default(0) @db.Decimal(19, 4)
  /// Run minutes the time-based lines were charged on.
  totalMinutes Decimal @default(0) @db.Decimal(19, 4)

  /// Optional pricing guidance. Null when no target was given — the engine
  /// does not invent a margin.
  targetMarginPercent Decimal? @db.Decimal(19, 4)
  suggestedPrice      Decimal? @db.Decimal(19, 4)

  notes String?

  computedAt   DateTime @default(now())
  computedById String?

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  productionOrder ProductionOrder?         @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  salesOrderLine  SalesOrderLine?          @relation(fields: [salesOrderLineId], references: [id], onDelete: Cascade)
  product         Product                  @relation(fields: [productId], references: [id])
  variant         ProductVariant           @relation(fields: [variantId], references: [id])
  computedBy      User?                    @relation(fields: [computedById], references: [id], onDelete: SetNull)
  formulas        CostCalculationFormula[]
  lines           CostCalculationLine[]

  @@index([tenantId, computedAt])
  @@index([productionOrderId])
  @@index([salesOrderLineId])
  @@index([variantId])
}

/// المعادلات المستخدمة في الحساب.
///
/// Derivable from the lines, but kept explicit so "which versions produced
/// this number" is one cheap query — and so a formula that contributed no
/// lines is still recorded as having been consulted.
model CostCalculationFormula {
  id                String @id @default(cuid())
  costCalculationId String
  formulaId         String
  formulaVersionId  String
  /// Denormalised so the snapshot reads without a join.
  version           Int
  formulaCode       String
  formulaNameAr     String
  kind              String

  costCalculation CostCalculation @relation(fields: [costCalculationId], references: [id], onDelete: Cascade)
  formulaVersion  FormulaVersion  @relation(fields: [formulaVersionId], references: [id])

  @@unique([costCalculationId, formulaVersionId])
  @@index([costCalculationId])
}

/// بند التكلفة — a formula line as it was at calculation time.
///
/// Every input is copied, not referenced. The formula line it came from may
/// later be superseded; this row must still explain the total it produced.
model CostCalculationLine {
  id                String @id @default(cuid())
  costCalculationId String
  sequence          Int

  /// Provenance — which version this came from.
  formulaId        String
  formulaVersionId String
  version          Int

  category String
  nameAr   String
  basis    String
  unit     String?

  /// Copied from the formula line.
  quantityPerBasis Decimal  @db.Decimal(19, 4)
  yieldQty         Decimal? @db.Decimal(19, 4)
  unitCost         Decimal  @db.Decimal(19, 4)

  /// Computed by the engine.
  consumedQty Decimal @db.Decimal(19, 4)
  lineCost    Decimal @db.Decimal(19, 4)

  costCalculation CostCalculation @relation(fields: [costCalculationId], references: [id], onDelete: Cascade)
  formulaVersion  FormulaVersion  @relation(fields: [formulaVersionId], references: [id])

  @@unique([costCalculationId, sequence])
  @@index([costCalculationId])
}

/// المرفقات.
///
/// Nullable foreign keys rather than an entityType/entityId pair, so the
/// database still enforces referential integrity. Exactly one owner is set.
model Attachment {
  id           String   @id @default(cuid())
  customerId   String?
  supplierId   String?
  quotationId  String?
  salesOrderId String?
  /// Phase 6.5 — receipts for expenses, photographs of damage. The columns
  /// exist so the upload feature does not have to alter a table that live
  /// records already reference; no upload UI is wired yet.
  expenseId    String?
  damageId     String?
  filename     String
  path         String
  mimeType     String
  bytes        Int
  uploadedBy   String?
  createdAt    DateTime @default(now())

  customer   Customer?         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  supplier   Supplier?         @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  quotation  Quotation?        @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  salesOrder SalesOrder?       @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  expense    SecondaryExpense? @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  damage     DamageRecord?     @relation(fields: [damageId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([supplierId])
  @@index([quotationId])
  @@index([salesOrderId])
  @@index([expenseId])
  @@index([damageId])
}

// ═══════════════════════════════════════════════════════════
// Invoicing & receivables — Phase 10
// ═══════════════════════════════════════════════════════════

/// عدّاد المستندات — gapless numbering.
///
/// Every other document in this system derives its number from the highest
/// existing one, which is fine because a gap in a quotation number is nobody's
/// business. An invoice is different: tax authorities generally require an
/// unbroken sequence, and proving one after the fact is impossible.
///
/// So invoices allocate from here, inside the issuing transaction, with the
/// row locked. Two clerks pressing Issue at the same instant queue rather than
/// collide, and a rolled-back transaction returns the number rather than
/// burning it.
///
/// The number is allocated on ISSUE, never on create — a draft that is
/// deleted must not leave a hole.
model DocumentSequence {
  id         String @id @default(cuid())
  tenantId   String
  /// INVOICE — one row per kind per year.
  kind       String
  year       Int
  /// Last number handed out. The next allocation is this plus one.
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, year])
}

/// فاتورة المبيعات.
///
/// Issued from a sales order, or standalone. Lines are copied, never joined:
/// the same snapshot discipline the quotation and the cost calculation follow.
/// Re-reading a two-year-old invoice must show what the customer was actually
/// charged, whatever the price list says today.
model Invoice {
  id       String  @id @default(cuid())
  tenantId String
  /// Null until issued. Allocated gaplessly at that moment.
  number   String?

  customerId   String
  salesOrderId String?

  /// DRAFT | ISSUED | PARTIALLY_PAID | PAID | VOID
  ///
  /// The paid states are DERIVED from the payments, never typed.
  status String @default("DRAFT")

  issueDate DateTime?
  /// issueDate + the tenant's payment term. Stored because the term may
  /// change later and this invoice's promise must not.
  dueDate   DateTime?

  subtotal       Decimal @default(0) @db.Decimal(19, 4)
  discountAmount Decimal @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal @default(0) @db.Decimal(19, 4)
  total          Decimal @default(0) @db.Decimal(19, 4)
  /// Sum of payments. A projection, maintained in the same transaction.
  paidAmount     Decimal @default(0) @db.Decimal(19, 4)

  notes      String?
  voidReason String?

  issuedById  String?
  createdById String?
  voidedAt    DateTime?

  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer      @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  issuedBy   User?         @relation("InvoiceIssuer", fields: [issuedById], references: [id], onDelete: SetNull)
  createdBy  User?         @relation("InvoiceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines      InvoiceLine[]
  payments   Payment[]

  @@unique([tenantId, number])
  @@index([tenantId, isDeleted])
  @@index([tenantId, status])
  @@index([customerId])
  @@index([tenantId, dueDate])
}

/// بند الفاتورة — a copy, not a reference.
model InvoiceLine {
  id        String @id @default(cuid())
  invoiceId String
  lineNo    Int    @default(1)

  /// Kept for reporting; the description is what the customer reads.
  productId   String?
  variantId   String?
  /// Frozen at issue: the product may be renamed, the invoice may not change.
  description String

  quantity       Decimal @db.Decimal(19, 4)
  unitPrice      Decimal @db.Decimal(19, 4)
  discountAmount Decimal @default(0) @db.Decimal(19, 4)
  taxRate        Decimal @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal @default(0) @db.Decimal(19, 4)
  lineTotal      Decimal @db.Decimal(19, 4)

  invoice Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([invoiceId])
}

/// دفعة.
///
/// Append-only, like every other ledger here. A payment entered wrongly is
/// corrected by a reversing payment that points at it, never by an edit —
/// money that moved and then un-moved is a fact, not a typo.
model Payment {
  id        String @id @default(cuid())
  tenantId  String
  number    String
  invoiceId String

  amount    Decimal  @db.Decimal(19, 4)
  /// CASH | BANK | CHEQUE | CARD | OTHER
  method    String
  paidAt    DateTime @default(now())
  /// Cheque number, transfer reference, whatever proves it.
  reference String?
  notes     String?

  /// Set when this payment reverses another. The original is never touched.
  reversesId String?  @unique
  reverses   Payment? @relation("PaymentReversal", fields: [reversesId], references: [id])
  reversedBy Payment? @relation("PaymentReversal")

  recordedById String?
  createdAt    DateTime @default(now())

  tenant     Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation(fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([tenantId, number])
  @@index([invoiceId])
  @@index([tenantId, paidAt])
}

// ═══════════════════════════════════════════════════════════
// Purchasing — Phase 9
// ═══════════════════════════════════════════════════════════

/// أمر الشراء.
///
/// Mirrors the sales order deliberately: same discount-then-tax arithmetic,
/// same snapshot discipline. A business that computes its buying differently
/// from its selling will eventually disagree with itself about margin.
model PurchaseOrder {
  id         String @id @default(cuid())
  tenantId   String
  number     String
  supplierId String

  /// DRAFT | CONFIRMED | PARTIALLY_RECEIVED | RECEIVED | CANCELLED
  ///
  /// The two received states are DERIVED from the delivery notes, never
  /// typed. A status the receipts do not support is a lie the warehouse
  /// discovers at the worst moment.
  status String @default("DRAFT")

  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  notes        String?

  subtotal       Decimal @default(0) @db.Decimal(19, 4)
  discountAmount Decimal @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal @default(0) @db.Decimal(19, 4)
  total          Decimal @default(0) @db.Decimal(19, 4)

  confirmedAt DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdById String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier  Supplier            @relation(fields: [supplierId], references: [id])
  createdBy User?               @relation("PurchaseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lines     PurchaseOrderLine[]
  receipts  GoodsReceipt[]

  @@unique([tenantId, number])
  @@index([tenantId, isDeleted])
  @@index([tenantId, status])
  @@index([supplierId])
}

/// بند أمر الشراء.
///
/// A line buys exactly one thing: a stocked variant, or a consumable supply.
/// Both columns nullable, exactly one set — a line with neither cannot move a
/// quantity or a cost, and would be an invoice line pretending to be a
/// purchase line.
model PurchaseOrderLine {
  id              String @id @default(cuid())
  purchaseOrderId String
  lineNo          Int    @default(1)

  /// VARIANT | SUPPLY
  target      String
  variantId   String?
  supplyId    String?
  /// What the supplier calls it, which is rarely what we call it.
  description String?

  quantity       Decimal @db.Decimal(19, 4)
  unitPrice      Decimal @db.Decimal(19, 4)
  discountAmount Decimal @default(0) @db.Decimal(19, 4)
  taxRate        Decimal @default(0) @db.Decimal(19, 4)
  taxAmount      Decimal @default(0) @db.Decimal(19, 4)
  lineTotal      Decimal @db.Decimal(19, 4)

  /// Running total of what has actually arrived. Maintained only by posting
  /// a receipt, never edited directly.
  receivedQty Decimal @default(0) @db.Decimal(19, 4)

  notes String?

  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant?    @relation(fields: [variantId], references: [id])
  supply        Supply?            @relation(fields: [supplyId], references: [id])
  receiptLines  GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@index([variantId])
  @@index([supplyId])
}

/// إذن استلام بضاعة.
///
/// A separate document because deliveries arrive in parts, and each part is
/// its own event with its own date and its own evidence. Folding them into a
/// "received quantity" field on the order would erase when things actually
/// turned up.
model GoodsReceipt {
  id              String @id @default(cuid())
  tenantId        String
  number          String
  purchaseOrderId String

  receiptDate DateTime @default(now())
  warehouseId String
  /// The supplier's own delivery note number, when there is one.
  reference   String?
  notes       String?

  receivedById String?
  createdAt    DateTime @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  warehouse     Warehouse          @relation(fields: [warehouseId], references: [id])
  receivedBy    User?              @relation(fields: [receivedById], references: [id], onDelete: SetNull)
  lines         GoodsReceiptLine[]

  @@unique([tenantId, number])
  @@index([tenantId, receiptDate])
  @@index([purchaseOrderId])
}

/// بند الاستلام.
///
/// The idempotency anchor for purchasing: StockMovement carries a unique
/// constraint on this row's id, so a receipt posted twice — a double-click, a
/// retried request — cannot move stock twice. The database enforces it, not
/// the application.
model GoodsReceiptLine {
  id                  String @id @default(cuid())
  goodsReceiptId      String
  purchaseOrderLineId String

  quantity Decimal @db.Decimal(19, 4)
  /// Copied from the order line at receipt time. The order may later be
  /// corrected; what stock was valued at on the day must not move.
  unitCost Decimal @db.Decimal(19, 4)

  notes String?

  goodsReceipt      GoodsReceipt        @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLine PurchaseOrderLine   @relation(fields: [purchaseOrderLineId], references: [id])
  movements         StockMovement[]
  supplyMovements   SupplyTransaction[]

  @@index([goodsReceiptId])
  @@index([purchaseOrderLineId])
}

// ═══════════════════════════════════════════════════════════
// Operations — expenses, damage, penalties, supplies (Phase 6.5)
// ═══════════════════════════════════════════════════════════

/// المصروفات الثانوية.
///
/// Everything that erodes net profit without belonging to a product: food,
/// fuel, rent, electricity. Kept out of the Cost Engine on purpose — spread
/// across units they would corrupt the per-piece manufacturing cost, which
/// must stay comparable between a run of 50 and a run of 5000.
model SecondaryExpense {
  id       String @id @default(cuid())
  tenantId String
  number   String

  expenseDate DateTime
  /// FOOD | TRANSPORT | FUEL | ELECTRICITY | WATER | INTERNET | CLEANING |
  /// OFFICE | MAINTENANCE | RENT | OTHER
  category    String
  amount      Decimal  @db.Decimal(19, 4)
  /// Optional — links to User until an HR Employee entity exists.
  employeeId  String?
  notes       String?

  /// PENDING | APPROVED | REJECTED. Only APPROVED counts against profit.
  status       String    @default("PENDING")
  approvedById String?
  approvedAt   DateTime?
  rejectReason String?

  createdById String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee    User?        @relation("ExpenseEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  approvedBy  User?        @relation("ExpenseApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  attachments Attachment[]

  @@unique([tenantId, number])
  @@index([tenantId, isDeleted])
  @@index([tenantId, expenseDate])
  @@index([tenantId, status])
}

/// محضر هالك / تالف.
///
/// Records what was spoiled, why, and what it cost. The reason is required:
/// a damage record without one is an unexplained loss, which is exactly the
/// thing this table exists to stop.
model DamageRecord {
  id       String @id @default(cuid())
  tenantId String
  number   String

  damageDate DateTime
  employeeId String?
  /// Free text until departments and machines are master data.
  department String?
  machine    String?

  productId         String?
  variantId         String?
  /// اسم منتج مكتوب يدوياً حين يكون التالف غير مرتبط بمنتج في النظام (خامة،
  /// منتج قيد التجهيز، صنف لم يُسجَّل بعد). يظهر في السجل والتقارير كبديل.
  productLabel      String?
  productionOrderId String?

  quantity Decimal @db.Decimal(19, 4)
  /// Required by validation, not merely by convention.
  reason   String

  materialCost Decimal @default(0) @db.Decimal(19, 4)
  laborCost    Decimal @default(0) @db.Decimal(19, 4)
  totalCost    Decimal @default(0) @db.Decimal(19, 4)

  /// DRAFT | PENDING | APPROVED | REJECTED
  status       String    @default("DRAFT")
  approvedById String?
  approvedAt   DateTime?
  rejectReason String?

  createdById String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        User?            @relation("DamageEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  approvedBy      User?            @relation("DamageApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("DamageCreator", fields: [createdById], references: [id], onDelete: SetNull)
  product         Product?         @relation(fields: [productId], references: [id])
  variant         ProductVariant?  @relation(fields: [variantId], references: [id])
  productionOrder ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  penalties       Penalty[]
  attachments     Attachment[]

  @@unique([tenantId, number])
  @@index([tenantId, isDeleted])
  @@index([tenantId, damageDate])
  @@index([tenantId, status])
  @@index([productionOrderId])
}

/// الجزاء.
///
/// Money taken from a person. Every one of them carries a reason, an
/// approver, and an append-only history — because a deduction someone cannot
/// account for later is not a control, it is a grievance.
model Penalty {
  id       String @id @default(cuid())
  tenantId String
  number   String

  damageId   String?
  employeeId String

  amount Decimal @db.Decimal(19, 4)
  reason String

  /// PENDING | APPROVED | PAID | CANCELLED
  status       String    @default("PENDING")
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  damage     DamageRecord?  @relation(fields: [damageId], references: [id], onDelete: SetNull)
  employee   User           @relation("PenaltyEmployee", fields: [employeeId], references: [id])
  approvedBy User?          @relation("PenaltyApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  createdBy  User?          @relation("PenaltyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  events     PenaltyEvent[]

  @@unique([tenantId, number])
  @@index([tenantId, status])
  @@index([employeeId])
  @@index([damageId])
}

/// سجل الجزاء — append-only.
///
/// Never updated, never deleted. The penalty row says what is true now; this
/// says how it got there and who decided.
model PenaltyEvent {
  id        String @id @default(cuid())
  penaltyId String

  fromStatus String?
  toStatus   String
  note       String?
  userId     String?

  createdAt DateTime @default(now())

  penalty Penalty @relation(fields: [penaltyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([penaltyId, createdAt])
}

/// مستلزمات الطباعة والتطريز.
///
/// Deliberately separate from Material and from stocked Products. These are
/// consumables bought and burned by a department, not variants sold to a
/// customer, and mixing them into product stock would make both figures
/// meaningless.
model Supply {
  id       String @id @default(cuid())
  tenantId String
  code     String
  nameAr   String

  /// PRINTING | EMBROIDERY
  kind     String
  /// ROLL | INK | CLEANING | TRANSFER_PAPER | THREAD | NEEDLE | FRAME |
  /// BACKING | OTHER — valid values depend on `kind`.
  category String
  unit     String?

  /// Latest known purchase price. A reference for data entry, never the
  /// source of truth for a past transaction — those carry their own.
  lastUnitCost Decimal? @db.Decimal(19, 4)
  /// Weighted average cost, recomputed on every delivery (Phase 9).
  ///
  /// This is what the Cost Engine should be priced from: the last invoice is
  /// an accident of timing, the average is what the stock on the shelf
  /// actually cost. Formula versions still freeze their own number — this
  /// only tells the manager what the true figure is when they edit a draft.
  avgCost      Decimal  @default(0) @db.Decimal(19, 4)
  /// Running balance, derived from transactions.
  onHand       Decimal  @default(0) @db.Decimal(19, 4)
  minStock     Decimal  @default(0) @db.Decimal(19, 4)

  notes     String?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions       SupplyTransaction[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([tenantId, code])
  @@index([tenantId, isDeleted])
  @@index([tenantId, kind])
}

/// حركة مستلزمات — append-only.
///
/// Purchases and consumption in one ledger, so monthly spend and monthly
/// burn are two queries over the same truth rather than two tables that can
/// disagree.
model SupplyTransaction {
  id       String @id @default(cuid())
  tenantId String
  supplyId String

  /// PURCHASE | CONSUMPTION
  type   String
  txDate DateTime

  quantity  Decimal @db.Decimal(19, 4)
  unitCost  Decimal @default(0) @db.Decimal(19, 4)
  totalCost Decimal @default(0) @db.Decimal(19, 4)

  /// Linked when consumption belongs to a specific run.
  productionOrderId  String?
  /// Linked when a purchase delivery is what put these units on the shelf.
  /// Unique below, for the same reason StockMovement is: a receipt posted
  /// twice must not raise the balance twice.
  goodsReceiptLineId String?
  notes              String?
  userId             String?

  createdAt DateTime @default(now())

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supply           Supply            @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  productionOrder  ProductionOrder?  @relation(fields: [productionOrderId], references: [id], onDelete: SetNull)
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  goodsReceiptLine GoodsReceiptLine? @relation(fields: [goodsReceiptLineId], references: [id])

  @@unique([goodsReceiptLineId, type])
  /// خصم واحد لكل أمر إنتاج ومستلزم. القيد على القاعدة لا في التطبيق:
  /// طلبان متزامنان يمرّان على الفحص معاً ولا يمرّان على القيد.
  @@unique([productionOrderId, supplyId, type])
  @@index([tenantId, txDate])
  @@index([supplyId, txDate])
  @@index([tenantId, type])
  @@index([productionOrderId])
}

/// شريحة سعر — سعر البيع حسب الخدمة والكمية.
///
/// أسعار كيان ليست رقماً واحداً لكل منتج: القطعة نفسها لها سعر مع التطريز
/// وسعر آخر مع طباعة DTF، ولكلٍّ سعر جملة وسعر للكميات الصغيرة. النموذج
/// القديم يحمل sellingPrice واحداً، وهو ما جعل نصف أسعار الإدارة غير قابل
/// للإدخال أصلاً.
///
/// كل شريحة قابلة للتعديل من الشاشة. لا سعر مكتوب في الكود.
model PriceTier {
  id       String @id @default(cuid())
  tenantId String

  productId String
  /// اختياري: شريحة تخصّ متغيّراً بعينه، أو المنتج كله حين تكون فارغة.
  variantId String?

  /// PRINTING | EMBROIDERY | DTF | NONE
  service String

  /// نطاق الكمية. maxQty فارغة تعني بلا حد أعلى.
  minQty Int  @default(1)
  maxQty Int?

  price    Decimal @db.Decimal(19, 4)
  currency String  @default("IQD")

  isActive Boolean @default(true)
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  /// لا شريحتان بنفس المفتاح: منتج × متغيّر × خدمة × حد أدنى.
  @@unique([productId, variantId, service, minQty])
  @@index([tenantId, productId])
}

/// نص من نصوص الموقع العام — يحرّره المدير من النظام.
///
/// النصوص كانت في site.ts، فتغيير كلمة يحتاج نشراً. صارت هنا ليعدّلها
/// المدير ويظهر التغيير فوراً — نص تسويقي بيان عمل لا كود.
///
/// المفتاح ثابت في الكود والقيمة في قاعدة البيانات. فمفتاح مفقود أو قاعدة
/// غير متاحة تعني عرض النص المكتوب في الكود لا فراغاً: الصفحة لا تفرغ أبداً.
model SiteContent {
  id       String @id @default(cuid())
  tenantId String

  /// مفتاح ثابت مثل service.printing.body
  key String

  /// النص كما يظهر على الموقع.
  valueAr String

  /// للتجميع في شاشة التحرير: hero | services | why | about
  group String

  /// وصف قصير يشرح للمدير أين يظهر هذا النص.
  label String

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, group])
}

/// شرائح الواجهة (Hero slider) على الصفحة الرئيسية.
///
/// الصورة نفسها بايتات في القاعدة، لا مسار على القرص. القرص يُمسح مع كل
/// نشر على الاستضافة المشتركة، فصورة مرفوعة هناك تضيع أول تحديث؛ وبايتات
/// في القاعدة تنجو من النشر وتُنقل مع النسخ الاحتياطي.
///
/// تُقدَّم عبر مسار /hero/img/<id>، ويُحسَّن حجمها بـ sharp عند الرفع فلا
/// يعيد محسّن Next معالجتها.
model HeroSlide {
  id       String @id @default(cuid())
  tenantId String

  /// اسم يظهر أسفل الشريحة.
  title String

  /// سطر ثانٍ اختياري تحت الاسم.
  subtitle String @default("")

  /// بايتات الصورة — LONGBLOB على MySQL. مُعالَجة webp عند الرفع.
  image Bytes

  /// نوع المحتوى للمسار الذي يقدّمها.
  mimeType String @default("image/webp")

  /// أبعاد الصورة المعالَجة — تفيد نسبة العرض ولا تُعاد قراءتها من البايتات.
  width  Int @default(0)
  height Int @default(0)

  /// الترتيب على الواجهة، الأصغر أولاً.
  sortOrder Int @default(0)

  /// شريحة معطّلة تبقى محفوظة ولا تظهر — كإيقاف منتج لا حذفه.
  isActive Boolean @default(true)

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, sortOrder])
}
